# Spendito frontend environment variables
#
# IMPORTANT: Every EXPO_PUBLIC_* variable is bundled into the app and is
# readable by anyone who opens the web app. NEVER put secrets here
# (PayPal client secret etc. belong only into backend/.env on Railway).

# Gemini AI: the API key is entered by the user in the app settings
# (stored in SecureStore / browser storage) - no environment variable needed.

# Optional: URL of the Spendito backend (Railway). Defaults to the production backend.
# EXPO_PUBLIC_BACKEND_URL=https://spendito-production.up.railway.app

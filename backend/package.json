{
  "name": "spendito-backend",
  "version": "1.0.0",
  "description": "Spendito Backend - stateless PayPal OAuth/reporting proxy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "postinstall": "npm run build",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [

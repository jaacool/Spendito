# Server Configuration
PORT=3001

# Frontend origins allowed to call this API (CORS) and to receive the PayPal
# login result (postMessage). Comma separated, exact origins (scheme://host[:port]),
# no trailing slash. REQUIRED in production - if empty, the web app cannot use the API.
# Must contain the production web app origin (Vercel), e.g. https://<your-app>.vercel.app
# Desktop app (Electron) runs on http://localhost:34567, Expo web dev on http://localhost:8081
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:8081

# PayPal API (Live) - server-side only, never put these into the frontend
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Set automatically by Railway; used to build the PayPal OAuth redirect URI
# RAILWAY_PUBLIC_DOMAIN=spendito-production.up.railway.app
